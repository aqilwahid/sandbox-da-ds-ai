{
  "name": "sandbox-da-ds-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-pyodide.mjs",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "npm run validate:content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve:lan": "vite preview --host 0.0.0.0 --port 4173",
    "setup:offline": "node scripts/setup-pyodide.mjs --offline",
    "setup:online": "node scripts/setup-pyodide.mjs --clean",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:content": "tsx scripts/test-content.ts",
    "typecheck": "tsc --noEmit",
    "datasets": "python3 scripts/generate_datasets.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.4",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
    "pyodide": "314.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  },
  "description": "Sandbox latihan hands-on Data Analyst (SQL/DuckDB), Data Science (Python) & AI Engineering yang berjalan penuh di browser, lengkap dengan visual interaktif dan penilaian otomatis.",
  "engines": {
    "node": ">=20"
  }
}
